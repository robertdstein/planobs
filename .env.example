# Copy to .env and fill in. .env is gitignored; never commit real tokens.
# Tokens are loaded by planobs.credentials on import.

# Fritz API token, issued on your fritz.science profile page
FRITZ_TOKEN=

# Kowalski, for submitting ToO triggers
KOWALSKI_API_TOKEN=
KOWALSKI_HOST=kowalski.caltech.edu

# IRSA/IPAC, for querying reference images
IRSA_USER=
IRSA_PASSWORD=
